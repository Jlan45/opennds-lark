# Copy to /etc/opennds/fas-lark.env and chmod 600.
# Do not commit a filled-in copy. The process reads this only when
# FAS_LARK_ENV_FILE points at it; values already in the environment win.
#
# OPENNDS_FASKEY must be the same letters-and-digits string as openNDS
# option faskey. Generate one with: openssl rand -hex 32

OPENNDS_FASKEY=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Event-subscription secrets. Leave empty when the bot only sends messages.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Chinese Feishu. International Lark: https://open.larksuite.com
FEISHU_API_BASE=https://open.feishu.cn

# 1 shows the code on the portal page and does not call Feishu. Never leave this on.
FEISHU_DRY_RUN=0

# 1 looks up an email via the contact API, then messages the open_id.
# Requires permission contact:user.id:readonly. Default 0 sends with receive_id_type=email.
FEISHU_RESOLVE_EMAIL=0

FAS_LISTEN=0.0.0.0
FAS_PORT=2080
# Optional. Used as the post-login landing host, for example status.client:2080
# FAS_PUBLIC_HOST=
# Optional pin. Refuse a portal blob whose gatewayaddress is not this value.
# OPENNDS_GATEWAY_ADDRESS=192.168.1.1:2050
OPENNDS_AUTHDIR=opennds_auth

OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_SENDS_PER_IP=8
OTP_MAX_SENDS_PER_ID=5
OTP_STORE_PATH=/tmp/opennds-lark/otp.json
FEISHU_HTTP_TIMEOUT=8
